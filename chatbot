# Simple Customer Support Chatbot

def chatbot():
    print("=== Welcome to Online Store Chatbot ===")
    print("Type 'bye' to exit.\n")

    while True:
        user = input("You: ").lower()

        if user == "hello" or user == "hi":
            print("Bot: Hello! How can I help you?")

        elif "product" in user:
            print("Bot: We sell laptops, mobiles, and headphones.")

        elif "price" in user:
            print("Bot: Prices start from ₹5000 onwards.")

        elif "delivery" in user:
            print("Bot: Delivery takes 3 to 5 business days.")

        elif "payment" in user:
            print("Bot: We accept UPI, Debit Card, Credit Card, and Net Banking.")

        elif "return" in user:
            print("Bot: Products can be returned within 7 days.")

        elif user == "bye":
            print("Bot: Thank you for visiting!")
            break

        else:
            print("Bot: Sorry, I didn't understand that.")

# Run chatbot
chatbot()
